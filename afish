local function deduplicateList(list)
    local seen, result = {}, {}
    for _, item in ipairs(list) do if not seen[item] then seen[item] = true; table.insert(result, item) end end
    return result
end
MASTER_ENTITY_LIST = deduplicateList(MASTER_ENTITY_LIST)

-- ============================
-- HELPER & SCANNER FUNCTIONS
-- ============================
local function getCharacter() return LocalPlayer.Character end

local function getRoot()
    local char = getCharacter()
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
end

local function getHumanoid()
    local char = getCharacter()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function scanAllEntities()
    local entities = {}
    local playerCharacters = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            playerCharacters[player.Character] = true
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("Folder")) and not playerCharacters[obj] then
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            local health = nil

            if humanoid then
                health = humanoid.Health
            else
                local healthValue = obj:FindFirstChild("Health")
                if healthValue and healthValue:IsA("NumberValue") then
                    health = healthValue.Value
                else
                    health = obj:GetAttribute("Health")
                end
            end

            if health and health > 0 then
                local rootPart = obj:FindFirstChild("HumanoidRootPart") 
                    or obj:FindFirstChild("Head") 
                    or obj:FindFirstChildWhichIsA("BasePart")

                if rootPart then
                    table.insert(entities, {
                        Model = obj,
                        Humanoid = humanoid,
                        Health = health,
                        MaxHealth = (humanoid and humanoid.MaxHealth) or 100,
                        RootPart = rootPart,
                        Position = rootPart.Position,
                        Name = obj.Name,
                        CFrame = rootPart.CFrame
                    })
                end
            end
        end
    end

    return entities
end

local function cleanTargetName(str)
    if not str then return "" end
    local name = str:gsub("%s*%(%d+%)", "")
    local baseName = name:match("^[^:]+") or name
    return baseName:gsub("^%s*(.-)%s*$", "%1")
end

local function getCleanName(fullName)
    return cleanTargetName(fullName)
end

-- ============================
-- BUILD ENTITY LIST
-- ============================
local function buildEntityList()
    local entities = scanAllEntities()
    local nameData = {}

    for _, name in ipairs(MASTER_ENTITY_LIST) do
        if not nameData[name] then
            nameData[name] = { count = 0, exists = false }
        end
    end

    for _, ent in ipairs(entities) do
        local clean = getCleanName(ent.Name)
        if not nameData[clean] then
            nameData[clean] = { count = 0, exists = false }
        end
        local data = nameData[clean]
        data.count = data.count + 1
        data.exists = true
    end

    local names = {}
    for name, data in pairs(nameData) do
        if include100HP or data.exists then
            if data.count > 0 then
                table.insert(names, name .. " (" .. data.count .. ")")
            else
                table.insert(names, name)
            end
        end
    end
    table.sort(names)
    return names
end

-- ============================
-- GET NEARBY ENTITIES
-- ============================
local function getAllNearbyEntities()
    local entities = scanAllEntities()
    local root = getRoot()
    local myPos = root and root.Position or Vector3.zero
    local filtered = {}

    for _, ent in ipairs(entities) do
        local dist = ent.Position and (ent.Position - myPos).Magnitude or math.huge
        if dist <= maxDistance then
            table.insert(filtered, ent)
        end
    end

    table.sort(filtered, function(a, b)
        local distA = a.Position and (a.Position - myPos).Magnitude or math.huge
        local distB = b.Position and (b.Position - myPos).Magnitude or math.huge
        return distA < distB
    end)

    return filtered
end

-- ============================
-- GET ENTITIES BY SELECTED NAME
-- ============================
local function getEntitiesByName(name)
    if not name then return {} end
    local clean = cleanTargetName(name)
    local entities = scanAllEntities()
    local matches = {}
    for _, ent in ipairs(entities) do
        if getCleanName(ent.Name) == clean then
            table.insert(matches, ent)
        end
    end
    local root = getRoot()
    if root then
        table.sort(matches, function(a, b)
            local distA = a.Position and (a.Position - root.Position).Magnitude or math.huge
            local distB = b.Position and (b.Position - root.Position).Magnitude or math.huge
            return distA < distB
        end)
    end
    return matches
end

-- ============================
-- FOLLOW LOGIC
-- ============================
local function calculateRelativeCFrame(targetRoot)
    if not targetRoot or not targetRoot.Parent then return nil end
    local targetCF = targetRoot.CFrame
    local offsetCF = CFrame.identity
    if positionMode == "Behind" then
        offsetCF = CFrame.new(0, 0, offsetDistance)
    elseif positionMode == "Above" then
        offsetCF = CFrame.new(0, offsetDistance, 0)
    elseif positionMode == "Below" then
        offsetCF = CFrame.new(0, -offsetDistance, 0)
    end
    return targetCF * offsetCF
end

local function followTarget(target)
    if not target or not target.RootPart or not target.RootPart.Parent then
        return
    end

    statusMessage = "Following: " .. getCleanName(target.Name)
    currentTarget = target
    skipCurrentTarget = false
    goToPreviousTarget = false

    while autoFarmEnabled and target and target.RootPart and target.RootPart.Parent do
        if skipCurrentTarget then
            skipCurrentTarget = false
            statusMessage = "Skipping to next target..."
            break
        end

        if goToPreviousTarget then
            goToPreviousTarget = false
            statusMessage = "Going back to previous target..."
            break
        end

        local hum = target.Humanoid
        local currentHealth = hum and hum.Health or target.Health
        if currentHealth and currentHealth <= 0 then
            break
        end

        local hrp = getRoot()
        if not hrp then break end

        local targetRoot = target.RootPart
        local dist = (targetRoot.Position - hrp.Position).Magnitude
        if dist > maxDistance * 1.5 then
            break
        end

        if movementMode == "Shadow" then
            local targetCF = calculateRelativeCFrame(targetRoot)
            if targetCF then hrp.CFrame = targetCF end
        elseif movementMode == "Fly" then
            local targetCF = calculateRelativeCFrame(targetRoot)
            if targetCF then
                local moveVec = targetCF.Position - hrp.Position
                if moveVec.Magnitude > 0.5 then
                    hrp.CFrame = CFrame.new(hrp.Position + moveVec.Unit * math.min(moveVec.Magnitude, flySpeed * 0.1), targetRoot.Position)
                else
                    hrp.CFrame = targetCF
                end
            end
        else -- Teleport
            local targetCF = calculateRelativeCFrame(targetRoot)
            if targetCF then hrp.CFrame = targetCF end
        end

        task.wait()
    end

    currentTarget = nil
    statusMessage = "Searching for targets..."
end

-- ============================
-- NEARBY AUTO FARM
-- ============================
local function nearbyAutoFarmCycle()
    if isFarming then return end
    isFarming = true

    while autoFarmEnabled and nearbyAutoFarmEnabled do
        local targets = getAllNearbyEntities()

        if #targets == 0 then
            statusMessage = "⚠️ No nearby entities found in range"
            task.wait(1)
        else
            statusMessage = "Nearby farm: " .. #targets .. " entities"
            for _, target in ipairs(targets) do
                if not autoFarmEnabled or not nearbyAutoFarmEnabled then break end
                if target.RootPart and target.RootPart.Parent and target.Health > 0 then
                    followTarget(target)
                    task.wait(0.1)
                end
            end
        end
        task.wait(0.2)
    end

    isFarming = false
end

-- ============================
-- ALL AUTO FARM (CYCLE SELECTED ENTITY)
-- ============================
local entityIndex = 1
local entityList = {}

local function allAutoFarmCycle()
    if isFarming then return end
    isFarming = true

    while autoFarmEnabled and allAutoFarmEnabled do
        if not selectedEntityName then
            statusMessage = "No entity selected"
            task.wait(1)
        else
            entityList = getEntitiesByName(selectedEntityName)
            if #entityList == 0 then
                statusMessage = "⚠️ No " .. cleanTargetName(selectedEntityName) .. " found"
                task.wait(1)
            else
                if entityIndex < 1 then entityIndex = #entityList end
                if entityIndex > #entityList then entityIndex = 1 end
                local target = entityList[entityIndex]
                if target and target.RootPart and target.RootPart.Parent and target.Health > 0 then
                    followTarget(target)
                    if not goToPreviousTarget then
                        entityIndex = entityIndex + 1
                        if entityIndex > #entityList then entityIndex = 1 end
                    else
                        goToPreviousTarget = false
                    end
                else
                    table.remove(entityList, entityIndex)
                    if #entityList == 0 then entityIndex = 1 else
                        if entityIndex > #entityList then entityIndex = 1 end
                    end
                end
            end
        end
        task.wait(0.2)
    end

    isFarming = false
end

-- ============================
-- MAIN LOOP (dispatcher)
-- ============================
local function mainLoop()
    while autoFarmEnabled do
        if nearbyAutoFarmEnabled then
            if not isFarming then task.spawn(nearbyAutoFarmCycle) end
        elseif allAutoFarmEnabled then
            if not isFarming then task.spawn(allAutoFarmCycle) end
        else
            statusMessage = "No farm mode enabled"
            task.wait(1)
        end
        task.wait(0.2)
    end
end

