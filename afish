-- Packets / Events setup
local Packets = Framework.Cache:GetGlobalReplicated("Client", "Packets")
local MinigamesPackets = Packets and Packets.Minigames

-- Function to complete any active minigame automatically
local function CompleteActiveMinigame()
    -- Method 1: Trigger via Manager Store/Module directly if available
    if MinigameManager and MinigameManager.new then
        local managerInstance = MinigameManager.new()
        if managerInstance and managerInstance.CurrentGame then
            print("[Auto-Minigame] Auto-completing active minigame instance...")
            
            -- Set progress to max and fire completion event
            managerInstance:UpdateProgress(1)
            managerInstance:CompleteMinigame({
                Success = true,
                Score = 100,
                Progress = 1,
                TimeElapsed = 0.1,
                Difficulty = "Master"
            })
            return
        end
    end

    -- Method 2: Fallback direct Packet transmission
    if MinigamesPackets and MinigamesPackets.Complete then
        print("[Auto-Minigame] Sending completion packet directly to server...")
        MinigamesPackets.Complete:Fire({
            Success = true,
            Score = 100,
            Progress = 1,
            TimeElapsed = 0.1,
            Difficulty = "Master"
        })
    end
end

-- Automatically listen for incoming Minigame Start packets
if MinigamesPackets and MinigamesPackets.Start then
    MinigamesPackets.Start.OnClientEvent:Connect(function(data)
        print("[Auto-Minigame] Minigame started! Difficulty:", data and data.Difficulty or "Easy")
        
        -- Small delay to bypass anti-cheat checks / instantaneous completion detection
        task.wait(0.15)
        
        CompleteActiveMinigame()
    end)
    print("Daley Hub Auto Fish Enabled!")
else
    warn("[Auto-Fishing] Auto Fishing Failed, Contact Daley")
end
