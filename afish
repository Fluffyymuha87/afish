local function clearEsp()
    for _, gui in pairs(espStorage) do if gui then gui:Destroy() end end
    table.clear(espStorage)
end

local function createBillboard(part, name, color)
    if not part or espStorage[part] then return end
    local bb = Instance.new("BillboardGui")
    bb.Name = "DaleyESP"
    bb.Adornee = part
    bb.Size = UDim2.new(0, 150, 0, 50)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    local txt = Instance.new("TextLabel", bb)
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextColor3 = color
    txt.TextStrokeTransparency = 0
    txt.TextSize = 13
    txt.Font = Enum.Font.SourceSansBold
    txt.Text = name
    bb.Parent = part
    espStorage[part] = bb
end

task.spawn(function()
    while task.wait(1) do
        if not playerEspEnabled and not entityEspEnabled then clearEsp() end
        if playerEspEnabled then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local head = player.Character:FindFirstChild("Head")
                    local hum = player.Character:FindFirstChildOfClass("Humanoid")
                    if head and hum and hum.Health > 0 then
                        createBillboard(head, player.Name .. " | " .. math.floor(hum.Health) .. " HP", Color3.fromRGB(0, 255, 127))
                    end
                end
            end
        end
        if entityEspEnabled then
            local entities = scanAllEntities()
            local myRoot = getRoot()
            for _, ent in ipairs(entities) do
                if ent.RootPart then
                    local dist = myRoot and math.floor((ent.RootPart.Position - myRoot.Position).Magnitude) or 0
                    createBillboard(ent.RootPart, getCleanName(ent.Name) .. "\nHP: " .. math.floor(ent.Health) .. "/" .. math.floor(ent.MaxHealth) .. "\n" .. dist .. "m", Color3.fromRGB(255, 170, 0))
                end
            end
        end
    end
end)

