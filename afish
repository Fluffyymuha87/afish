RunService.Heartbeat:Connect(function()
    local root = getRoot()
    local hum = getHumanoid()
    local cam = Workspace.CurrentCamera
    if not root or not hum then return end

    if speedEnabled and hum.MoveDirection.Magnitude > 0 and not flyEnabled then
        root.CFrame = root.CFrame + (hum.MoveDirection * (speedValue - hum.WalkSpeed) * 0.016)
    end

    if jumpEnabled then
        hum.JumpPower = jumpValue
        hum.UseJumpPower = true
    end

    if flyEnabled and cam then
        local moveDir = Vector3.zero
        local camCF = cam.CFrame
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir -= Vector3.new(0, 1, 0) end

        hum.PlatformStand = true
        root.AssemblyLinearVelocity = Vector3.zero
        if moveDir.Magnitude > 0 then
            root.CFrame = root.CFrame + (moveDir.Unit * flySpeed * 0.016)
        end
    elseif hum.PlatformStand and not flyEnabled then
        hum.PlatformStand = false
    end
end)

